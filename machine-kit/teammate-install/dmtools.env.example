# dmtools.env — machine-kit/teammate-install
# ─────────────────────────────────────────────────────────────────────
# Committed template. Copy to dmtools.env (git-ignored, same dir):
#   cp dmtools.env.example dmtools.env
# Provider: z.ai (fa catalog kind "zai" — the CODING plan endpoint).
# FILL ME: set ZAI_API_KEY in dmtools.env — everything else is ready.
# (install-dmtools-fa.json → install.sh sources this file; the real
# environment still wins. This file is git-ignored.)

# ── 1. dmtools-dart CLI (Dart orchestrator, epam/dmtools-dart) ──────
DMTOOLS_DART_VERSION=latest
# Side-by-side with the Java CLI — never clobbers ~/.dmtools.
DMTOOLS_DART_INSTALL_DIR="${HOME}/.dmtools-dart"

# ── 2. fa CLI (agent harness, IstiN/flutter_agent_harness) ──────────
FA_VERSION=latest
FA_INSTALL_DIR="${HOME}/.local/bin"

# ── 3. fa provider preconfig — z.ai, ready except the key ───────────
FA_PROVIDER_TYPE=zai
FA_PROVIDER_CONFIG='{"baseUrl":"https://api.z.ai/api/coding/paas/v4","model":"glm-5.3","apiKeyEnvVar":"ZAI_API_KEY"}'

# >>> THE ONLY THING TO FILL: <<<
ZAI_API_KEY=__FILL_ME__

# Model override (optional): glm-5.3 is the coding endpoint's flagship
# (text-only). Change it here if needed:
#   FA_PROVIDER_CONFIG='{"baseUrl":"https://api.z.ai/api/coding/paas/v4","model":"glm-4.7","apiKeyEnvVar":"ZAI_API_KEY"}'
