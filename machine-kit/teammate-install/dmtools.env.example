# dmtools.env.example — machine-kit/teammate-install (committed template)
# Copy to dmtools.env (git-ignored, same dir) and fill the placeholders.
# ─────────────────────────────────────────────────────────────────────
# FILL ME: replace every __FILL_ME__ / __OPTIONAL__ below, then the
# CliAgent job (install-dmtools-fa.json → install.sh) picks this file up
# automatically (install.sh sources it; values here never leave the
# machine — this file is git-ignored).
#
# Precedence inside install.sh: real environment > this file > defaults.

# ── 1. dmtools-dart CLI (Dart orchestrator, epam/dmtools-dart) ──────
# Release tag to install, or "latest".
DMTOOLS_DART_VERSION=latest
# Install root; binary lands in <dir>/bin/dmtools. Default ~/.dmtools-dart
# (side-by-side with the Java CLI — never clobbers ~/.dmtools).
DMTOOLS_DART_INSTALL_DIR="${HOME}/.dmtools-dart"

# ── 2. fa CLI (agent harness, IstiN/flutter_agent_harness) ──────────
# Release tag to install, or "latest".
FA_VERSION=latest
# Install dir; binary lands in <dir>/fa, shared libs in ../lib.
# Default ~/.local/bin (same layout the upstream installer produces).
FA_INSTALL_DIR="${HOME}/.local/bin"

# ── 3. fa provider preconfig (headless env contract) ────────────────
# Catalog kind: anthropic | google | dial | openai-completions | zai |
# aiin | minimax | chatgpt-codex | copilot | codemie | ollama | openai |
# openrouter | kimi | ...
FA_PROVIDER_TYPE=dial
# JSON, REQUIRED by fa: baseUrl + model are mandatory (fa never guesses
# catalog defaults); apiKeyEnvVar names the env var carrying the key.
FA_PROVIDER_CONFIG='{"baseUrl":"https://ai-proxy.lab.epam.com","model":"__FILL_ME__","apiKeyEnvVar":"DIAL_API_KEY"}'

# The API key itself — named by apiKeyEnvVar above.
DIAL_API_KEY=__FILL_ME__
# DIAL Core only: appended as ?api-version= when the deployment needs it.
DIAL_API_VERSION=__OPTIONAL__
